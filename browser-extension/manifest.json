{
  "manifest_version": 3,
  "name": "SOWAI Browser Agent",
  "version": "1.1.0",
  "description": "Permette a SOWAI di controllare questo browser (tutte le tab) come un operatore remoto.",
  "permissions": ["tabs", "scripting", "storage", "activeTab", "alarms", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["console_capture.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "SOWAI Browser Agent" }
}
